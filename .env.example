DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
APP_ENV=local
# Set to true temporarily to show PHP errors in the browser when debugging a 500.
APP_DEBUG=false
# If the host returns 500 on HTML routes only, try true temporarily to rule out CSP/WAF issues.
DISABLE_CSP=false

# --- Email sign-in (OTP via SMTP) ---
# Comma-separated list of addresses allowed to receive a one-time code (required for OTP login).
AUTH_ALLOWED_EMAILS=
# Code validity window in seconds (e.g. 600 = 10 minutes).
OTP_TTL_SECONDS=600
# Optional rate limits (per hour).
AUTH_OTP_MAX_PER_EMAIL_PER_HOUR=5
AUTH_OTP_MAX_PER_IP_PER_HOUR=20
AUTH_OTP_MIN_SECONDS_BETWEEN_REQUESTS=45

SMTP_HOST=
SMTP_PORT=587
# tls | ssl | empty (no encryption; not recommended)
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Private Lending
